{
	"name": "n8n-nodes-charm-hyper",
	"version": "1.0.0",
	"description": "n8n nodes for the Charm Hyper inference API (OpenAI- and Anthropic-compatible).",
	"license": "MIT",
	"homepage": "https://github.com/kanjizoiie/n8n-nodes-charm-hyper",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"charm",
		"hyper",
		"llm",
		"ai",
		"openai",
		"anthropic"
	],
	"author": {
		"name": "Marcus Johansson",
		"email": "mjohansson9512@gmail.com",
		"url": "https://github.com/kanjizoiie"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanjizoiie/n8n-nodes-charm-hyper.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CharmHyperApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CharmHyper/CharmHyper.node.js",
			"dist/nodes/CharmHyperChatModel/CharmHyperChatModel.node.js"
		]
	},
	"devDependencies": {
		"@n8n/ai-node-sdk": "^0.30.1",
		"@n8n/node-cli": "^0.49.1",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*",
		"@n8n/ai-node-sdk": "*"
	}
}
